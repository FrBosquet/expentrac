{
  "name": "expentrac",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "pnpm prisma:generate && next build --webpack && node scripts/assert-build.cjs",
    "build:dev": "next build --webpack && node scripts/assert-build.cjs",
    "start": "next start",
    "lint": "eslint app components lib actions sdk store hooks types.ts --max-warnings=0",
    "vercel:env_pull": "pnpm exec vercel env pull .env.local",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "email": "email dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "pnpm test --runInBand && pnpm typecheck && pnpm lint",
    "test:db": "node scripts/test-database.mjs node_modules/.bin/jest lib/server/database.integration.test.ts --runInBand",
    "test:queries": "node scripts/test-database.mjs node scripts/measure-queries.mjs",
    "test:browser": "node scripts/test-database.mjs node scripts/browser-tests.mjs",
    "test:money": "EXPENTRAC_MONEY_FIXTURE=true node scripts/test-database.mjs",
    "migration:production": "node scripts/migrate-production.mjs",
    "test:emails": "node --import tsx scripts/test-emails.tsx"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next-auth/prisma-adapter": "1.0.7",
    "@next/mdx": "^16.4.1",
    "@number-flow/react": "^0.6.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-form": "^0.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.357.0",
    "next": "^16.4.1",
    "next-auth": "^4.24.15",
    "next-mdx-remote": "^6.0.0",
    "nextjs-toploader": "^3.9.17",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.1",
    "react-icons": "^5.0.1",
    "recharts": "^3.10.1",
    "remark-unwrap-images": "^4.0.0",
    "resend": "^6.33.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "yaml": "2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@types/jest": "^29.5.12",
    "@types/mdx": "^2.0.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "dotenv-cli": "^7.4.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "^29.7.0",
    "postcss": "8.5.30",
    "prettier": "^3.3.2",
    "prisma": "^7.10.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "webpack": "5.111.1"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.20.0"
  },
  "pnpm": {
    "overrides": {
      "webpack": "5.111.1",
      "ws": "8.22.0",
      "mysql2": "3.24.6",
      "deepmerge-ts": "8.0.2"
    }
  }
}
